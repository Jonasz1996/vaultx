# Kopieer naar docker/.env en vul in. Nooit committen.

# Database
POSTGRES_PASSWORD=verander-mij

# Publieke URL zoals gebruikers VaultX openen (via Nginx Proxy Manager), zonder slash.
VAULTX_PUBLIC_URL=https://vaultx.example.com
VAULTX_HTTP_PORT=8080

# Minstens 32 willekeurige tekens, bv. `openssl rand -base64 48`
VAULTX_SECRET_KEY=

# Authentik OAuth2/OpenID-provider (zie docs/authentik.md)
# Issuer exact zoals in Authentik getoond, met slash op het einde.
VAULTX_OIDC_ISSUER=https://auth.example.com/application/o/vaultx/
VAULTX_OIDC_CLIENT_ID=
VAULTX_OIDC_CLIENT_SECRET=
VAULTX_OIDC_SCOPES=openid email profile
# Authentik-groepen die VaultX-instantiebeheerder maken (komma-gescheiden)
VAULTX_OIDC_ADMIN_GROUPS=vaultx-admins
# Groepen 'vaultx:<org>[:rol]' en 'vaultx:<org>/<team>[:rol]' worden lidmaatschappen
VAULTX_OIDC_GROUP_SYNC=true
VAULTX_OIDC_GROUP_PREFIX=vaultx:
# Interne CA voor Authentik? Zet tijdelijk op false, beter: CA in de image opnemen.
VAULTX_OIDC_VERIFY_TLS=true

# Sessies
VAULTX_SESSION_TTL_HOURS=12
VAULTX_SESSION_IDLE_MINUTES=120
# Enkel false zetten bij testen zonder HTTPS
VAULTX_COOKIE_SECURE=true

VAULTX_LOG_LEVEL=INFO

# NPM-connector: elke zoveel minuten alle actieve NPM-koppelingen inlezen (0 = enkel handmatig).
# Het NPM-wachtwoord wordt versleuteld met een sleutel afgeleid van VAULTX_SECRET_KEY:
# wijzig je die, vul dan het wachtwoord van elke koppeling opnieuw in.
VAULTX_NPM_SYNC_INTERVAL_MINUTES=15

# Authentik-API (fase 4): laat VaultX bij "Beschermen met Authentik" zelf de proxy provider,
# applicatie, groepsbinding en outpost-toewijzing aanmaken. Leeg token = uit.
# Gebruik een serviceaccount met enkel de rechten uit docs/npm.md (sectie 6), geen superuser-token.
# VAULTX_AUTHENTIK_API_URL=https://auth.example.com   # leeg = host van VAULTX_OIDC_ISSUER
VAULTX_AUTHENTIK_API_TOKEN=
# VAULTX_AUTHENTIK_VERIFY_TLS=true
# VAULTX_AUTHENTIK_AUTHORIZATION_FLOW=default-provider-authorization-implicit-consent
# VAULTX_AUTHENTIK_INVALIDATION_FLOW=default-provider-invalidation-flow
