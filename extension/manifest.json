{
  "manifest_version": 3,
  "name": "VaultX Invuller",
  "short_name": "VaultX",
  "version": "0.1.0",
  "description": "Vult je logins uit je VaultX-kluis automatisch in, met Enter, ook de tweestapscode.",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "VaultX Invuller", "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "48": "icons/icon-48.png" } },
  "background": { "service_worker": "background.js", "scripts": ["lib/vendor/argon2.umd.min.js", "lib/bw.js", "lib/match.js", "lib/totp.js", "background.js"] },
  "permissions": ["storage", "alarms", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "browser_specific_settings": { "gecko": { "id": "vaultx-invuller@vaultx.local", "strict_min_version": "128.0" } }
}
