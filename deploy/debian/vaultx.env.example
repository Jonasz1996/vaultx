# /etc/vaultx/vaultx.env voor een Debian-container zonder Docker (docs/debian-ct.md).
# Rechten: chmod 640, groep vaultx. Bewaar een kopie veilig (docs/backup.md): zonder
# VAULTX_SECRET_KEY zijn de NPM-wachtwoorden, client secrets en kluistokens onbruikbaar.

# --- Verplicht ---------------------------------------------------------------
VAULTX_DATABASE_URL=postgresql+psycopg://vaultx:WACHTWOORD@127.0.0.1:5432/vaultx
# Publieke URL zoals gebruikers VaultX openen (via Nginx Proxy Manager), zonder slash.
VAULTX_PUBLIC_URL=https://vaultx.jouwdomein.be
# Optioneel: andere adressen waarop je VaultX ook opent, kommagescheiden (docs/authentik.md).
# VAULTX_EXTRA_ORIGINS=https://vaultx.lan,http://192.168.0.50
# Minstens 32 willekeurige tekens: openssl rand -base64 48
VAULTX_SECRET_KEY=
# Authentik OAuth2/OpenID-provider (docs/authentik.md): issuer exact zoals Authentik hem toont, met slash.
VAULTX_OIDC_ISSUER=https://auth.jouwdomein.be/application/o/vaultx/
VAULTX_OIDC_CLIENT_ID=
VAULTX_OIDC_CLIENT_SECRET=

# --- Login en groepen (standaardwaarden) -------------------------------------
# VAULTX_OIDC_SCOPES=openid email profile
# VAULTX_OIDC_ADMIN_GROUPS=vaultx-admins
# VAULTX_OIDC_GROUP_SYNC=true
# VAULTX_OIDC_GROUP_PREFIX=vaultx:
# VAULTX_OIDC_VERIFY_TLS=true
# VAULTX_SESSION_TTL_HOURS=12
# VAULTX_SESSION_IDLE_MINUTES=120
# Enkel false bij testen zonder HTTPS; de sessiecookie is anders Secure.
# VAULTX_COOKIE_SECURE=true
# VAULTX_LOG_LEVEL=INFO

# --- Gewone login met VaultX-wachtwoord (fase 8, docs/accounts.md) ------------
# VAULTX_LOCAL_LOGIN_ENABLED=true
# VAULTX_LOCAL_LOGIN_MAX_FAILED=5
# VAULTX_LOCAL_LOGIN_LOCKOUT_MINUTES=15
# VAULTX_DATABASE_POOL_SIZE=10

# --- Nginx Proxy Manager (fase 1) ---------------------------------------------
# Elke zoveel minuten alle actieve NPM-koppelingen inlezen (0 = enkel handmatig).
# VAULTX_NPM_SYNC_INTERVAL_MINUTES=15

# --- Authentik-API (fase 4-6, docs/npm.md sectie 6) ---------------------------
# Token van een serviceaccount met beperkte rechten; leeg = VaultX maakt niets aan in Authentik.
VAULTX_AUTHENTIK_API_TOKEN=
# VAULTX_AUTHENTIK_API_URL=https://auth.jouwdomein.be        # leeg = host van de issuer
# VAULTX_AUTHENTIK_PUBLIC_URL=https://auth.jouwdomein.be     # leeg = host van de issuer
# VAULTX_AUTHENTIK_VERIFY_TLS=true
# VAULTX_AUTHENTIK_AUTHORIZATION_FLOW=default-provider-authorization-implicit-consent
# VAULTX_AUTHENTIK_INVALIDATION_FLOW=default-provider-invalidation-flow
# VAULTX_AUTHENTIK_SIGNING_KEY=authentik Self-signed Certificate

# --- Kluis en notities (fase 2 en 7, docs/bitwarden.md en docs/notes.md) --------
# VAULTX_VAULT_ENABLED=true
# VAULTX_VAULT_ACCESS_TOKEN_MINUTES=60
# VAULTX_VAULT_DEVICE_IDLE_DAYS=30
# VAULTX_VAULT_MAX_FAILED_LOGINS=10
# VAULTX_VAULT_LOCKOUT_MINUTES=15
# Hoger dan 25? Zet dan ook client_max_body_size in nginx-vaultx.conf hoger.
# VAULTX_VAULT_NOTE_FILE_MAX_MB=25
# VAULTX_VAULT_NOTE_STORAGE_MB=1024
# Fase 9: bijlagen bij items in de Bitwarden-apps en websitepictogrammen (uitgaand 80/443)
# VAULTX_VAULT_ATTACHMENT_MAX_MB=100
# VAULTX_VAULT_ATTACHMENT_STORAGE_MB=2048
# VAULTX_VAULT_ICONS=true
